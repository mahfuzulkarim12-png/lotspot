# Lotspot preview environment — template only. Copy to preview.env and fill in
# real values on the deploy host; never commit the filled-in file.
#
# Bind address inside the container (Dockerfile already sets these — override
# only if the hosting platform requires a different port).
LOTSPOT_HOST=0.0.0.0
LOTSPOT_PORT=8080

# Admin login seeded on first boot. Must be changed from the app defaults
# before the preview URL is shared with anyone outside the team.
LOTSPOT_ADMIN_USER=admin
LOTSPOT_ADMIN_PASSWORD=__set-a-real-preview-password__

# Shared key the POS terminal sends as X-API-Key to POST /api/pos/sales.
# Leave unset to disable POS intake on this preview.
LOTSPOT_POS_API_KEY=__set-a-preview-pos-key__

# SQLite file path inside the container. Defaults to backend/lotspot.db;
# override to point at a mounted volume so preview data survives restarts.
LOTSPOT_DB=/data/lotspot.db

# SSE heartbeat interval in seconds (defaults to 15 if unset).
LOTSPOT_SSE_HEARTBEAT=15
